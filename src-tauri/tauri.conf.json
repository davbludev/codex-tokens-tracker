{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex usage",
  "version": "0.1.0",
  "identifier": "dev.davblu.codex-tokens-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Codex usage", "width": 760, "height": 480, "minWidth": 420, "minHeight": 340 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": { "active": false }
}
